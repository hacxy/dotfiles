{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mimo": {
      "models": {
        "mimo-v2.5": {
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "MiMo V2.5"
        },
        "mimo-v2.5-pro": {
          "reasoning": true,
          "attachment": false,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "MiMo V2.5 Pro"
        }
      },
      "name": "Xiaomi MiMo Token Plan (China)",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1",
        "setCacheKey": true
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--image-responses=omit"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "lsp": true,
  "tools": {
    "playwright_browser_take_screenshot": false
  }
}
