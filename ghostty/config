# ============================================
# Ghostty Configuration
# 转换自 kitty/kitty.conf
# ============================================

# ---------- 字体 ----------
font-family = JetBrainsMono Nerd Font
font-size = 18.0
font-thicken = false

# ---------- 窗口 ----------
window-padding-x = 5
window-padding-y = 5
background-opacity = 0.90
background-blur = 64
window-save-state = never
macos-titlebar-style = tabs
window-decoration = auto

# ---------- 光标 ----------
cursor-style = block
cursor-style-blink = false

# ---------- 鼠标 ----------
mouse-hide-while-typing = true

# ---------- macOS 特定 ----------
macos-option-as-alt = true

# ---------- 主题 (Dracula) ----------
theme = Atom One Dark

# ---------- 快捷键映射 ----------

# 兼容 nvim 键位: Ctrl+` → Ctrl+_
keybind = ctrl+grave_accent=text:\x1f

